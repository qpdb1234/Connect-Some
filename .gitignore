*.iml
.gradle
/local.properties
/.idea
.DS_Store
/build
/captures
.externalNativeBuild
.cxx
*.apk
*.ap_
*.aab
app/build/
*.so
*.hprof

# Kotlin/Gradle working state: caches and the incremental build info, all of it
# regenerated by a build.
.kotlin/
**/.kotlin/
**/build/

# Ad-hoc scripts and dumps used while editing the resources or driving the device
# from a shell. Nothing under here is needed to build the app.
/_*
*.log

# Generated by :app:packageAndroidServerJar (a renamed copy of the :androidserver
# debug APK). Build artefact, never committed - regenerating it only needs a build.
app/src/main/res/raw/android_server.jar
androidserver/build/

# libjpeg-turbo: upstream checkout and intermediate build trees. The installed
# archives under extern/jpeg-prebuilt are kept - CMake needs them to enable the
# Tight encoding - regenerate them with extern/build-libjpeg-turbo.ps1.
extern/libjpeg-turbo/
extern/build/

# Local SDK location (an absolute path on the machine that built the app).
local.properties

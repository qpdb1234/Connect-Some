<?xml version="1.0" encoding="utf-8"?><!--
  Strings for the extra protocols (VNC / RFB and the Android-device protocol)
  and for the parts of the UI that have to distinguish them. Kept apart from
  strings_moonlight.xml (which carries the GameStream kernel strings) so the
  protocol split is visible in the resources too. Defaults are English;
  translate in values-zh-rCN / values-zh-rTW.
-->
<resources>

    <!--
      Protocol choice in the profile editor (the one place the user picks it).
      Bare protocol names only, because the three choices share one line - and
      'RFB' is what this app actually speaks, 'VNC' being the client side of it.
    -->
    <string name="protocol_game_stream">GameStream</string>
    <string name="protocol_vnc">RFB</string>
    <string name="protocol_android">ADB</string>

    <!-- Short protocol name on a server card. Same wording as the editor choice. -->
    <string name="protocol_badge_game_stream">GameStream</string>
    <string name="protocol_badge_vnc">RFB</string>
    <string name="protocol_badge_android">ADB</string>

    <!--
      Shown in the editor when libnative-vnc.so is missing from this build. The
      GameStream protocol stays usable, so this is a note about one option only.
    -->
    <string name="msg_vnc_unavailable">This build does not contain the VNC (RFB) native library, so VNC servers cannot be added or connected. GameStream / Sunshine hosts are unaffected.</string>

    <!-- Warns that saving after a protocol switch discards the old protocol's options. -->
    <string name="msg_protocol_switched">Protocol-specific options of this saved server will be reset when you save. Pairing data is kept.</string>

    <!-- VNC-only profile field. -->
    <string name="title_use_local_cursor">Draw the remote cursor on this device</string>

    <!--
      Wake-on-LAN. Waking is a separate action from connecting, which is why it
      has its own card button.
    -->
    <string name="desc_wake_server_btn">Wake this server</string>
    <string name="action_wol_fill_broadcast">Use my network\'s broadcast address</string>
    <string name="msg_wol_sent">Magic packet sent for %1$s</string>
    <string name="msg_wol_failed">Could not send the magic packet: %1$s</string>
    <string name="msg_wol_no_local_network">This device is not on a Wi-Fi or wired network, so the broadcast address cannot be worked out.</string>
    <string name="msg_wol_target_not_ipv4">Enter the computer\'s IPv4 address first - the broadcast address is derived from it.</string>
    <string name="action_wol_scan_mac">Scan for the MAC address</string>
    <string name="msg_wol_mac_found">MAC address found: %1$s</string>
    <string name="msg_wol_mac_not_found">No source reported a MAC address for %1$s. Type it in instead.</string>
    <string name="msg_invalid_ipv4_address">Invalid IPv4 address</string>
    <string name="msg_invalid_port">Enter a port between 1 and 65535</string>

    <!--
      Manual scan. A round walks the whole subnet, so it only ever runs from this
      button.
    -->
    <string name="action_scan">Scan</string>
    <string name="title_unnamed_device">Unnamed device</string>
    <string name="label_discovered_mac">MAC %1$s</string>
    <!-- A device model learned from an mDNS TXT attribute, shown under the card title. -->
    <string name="label_discovered_model">Model %1$s</string>
    <!-- A folded card names every port its protocol answered on, so the one card that
         replaced several still shows the range it stands for. -->
    <string name="label_discovered_ports">ports %1$s</string>
    <string name="msg_discovered_no_service">No supported service found on this device</string>

    <!--
      Scan progress. A round runs for tens of seconds and fills the list while it goes, so
      the tab names the stage it is in and counts the cards found so far; the subnet walk's
      own percentage is on the ring next to this line, which is why it is not repeated here.
    -->
    <string name="msg_discovery_idle">No scan yet. Tap Scan to look for machines on this network.</string>
    <string name="msg_scan_browsing">Listening for announcements \u00b7 %1$d found</string>
    <string name="msg_scan_walking">Walking the subnet \u00b7 %1$d found</string>
    <string name="msg_scan_probing">Checking remote-desktop ports \u00b7 %1$d found</string>
    <string name="msg_scan_naming">Looking up names \u00b7 %1$d found</string>
    <string name="msg_scan_settling">Waiting for the last announcements \u00b7 %1$d found</string>
    <string name="msg_scan_none">The scan found nothing on this network</string>
    <!-- A VPN's local proxy accepts every connection, which would make the whole subnet look
         like live servers. The scan therefore pins each probe to the physical network and only
         shows machines it can confirm there; this says why the list can look shorter under a VPN. -->
    <string name="msg_scan_vpn_hint">A VPN is hijacking this scan. Only machines confirmed on the local network are shown; allow your LAN in the VPN (or turn it off) and scan again</string>
    <plurals name="msg_scan_done">
        <item quantity="one">Found %1$d device, %2$d of them connectable</item>
        <item quantity="other">Found %1$d devices, %2$d of them connectable</item>
    </plurals>
    <string name="title_copy_mac">Copy MAC address</string>
    <!-- A discovered card always carries an address; a saved server may hold a hostname instead,
         which is why the two lists word their copy action differently. -->
    <string name="title_copy_ip_address">Copy IP address</string>
    <string name="title_add_as_server">Add as server</string>
    <!-- The same hand-written add, but the hardware address the scan learned goes straight
         into the Wake-on-LAN fields, which is the only reason to prefer it. -->
    <string name="title_add_server_with_wol">Add as server and fill in WoL</string>

    <!--
      A card whose hardware address no source could name still says so. The two long-press
      entries stay on the menu either way, so the app answers the question instead of
      pretending the question does not apply to this machine.
    -->
    <string name="label_discovered_mac_unknown">MAC not found</string>
    <string name="msg_mac_not_found">No MAC address was found for this device</string>

    <!--
      Android-device protocol: the controlled device has to authorise this app
      first, so most of these are instructions rather than error texts.
    -->
    <string name="label_android_codec">Use H.265 (HEVC) when the device supports it</string>
    <string name="label_android_audio">Forward the device\'s system audio</string>
    <string name="label_android_direct_touch">Send touches straight to the device (multi-touch)</string>
    <string name="label_android_keep_awake">Keep the device awake while mirrored</string>

    <string name="action_android_select_usb">Pick a USB device</string>
    <string name="label_android_usb_none">No USB device selected - connecting over the network</string>
    <string name="msg_android_no_usb_device">No USB device is connected. Plug the cable in (this phone must support OTG) and try again.</string>
    <string name="msg_android_usb_permission">This app may not access that USB device yet. Allow it in the system dialog, then connect again.</string>
    <string name="msg_android_usb_allow_debugging">On the controlled device, accept the \"Allow USB debugging?\" prompt, then connect again.</string>
    <string name="msg_android_key_limit">This protocol has no key release: every key becomes a short press, so holding a key, repeats and modifier chords are unavailable.</string>
    <string name="msg_android_text_via_clipboard">This character has no key code, so it was put on the device\'s clipboard - paste it there.</string>

    <string name="title_android_pair">Wireless debugging pairing</string>
    <string name="hint_android_pair_code">6-digit pairing code</string>
    <string name="hint_android_pair_port">Pairing port</string>
    <string name="hint_android_connect_port">Connection port (shown on the wireless debugging screen)</string>
    <string name="msg_android_pairing_unavailable">This build does not contain the ADB wireless pairing component. Use a USB-OTG cable, or a device that already trusts this one.</string>
    <string name="msg_android_pair_success">Paired. Fill in the connection port shown on the device and save.</string>
    <string name="msg_android_pair_failed">Pairing failed: %1$s</string>

    <!--
      Cable to wireless: adbd is restarted on TCP through the cable, so the cable session
      is sacrificed. That is why the address is verified before it is written into the form.
    -->
    <string name="action_android_tcpip">Wireless ADB over USB</string>
    <string name="title_android_tcpip">Switch the cabled device to wireless ADB</string>
    <string name="hint_android_tcpip_port">TCP port (usually 5555)</string>
    <string name="msg_android_tcpip_needs_usb">Pick a USB device first - this switch can only run over the cable.</string>
    <string name="msg_android_tcpip_no_ip">The device reported no network address. Connect it to Wi-Fi and try again.</string>
    <string name="msg_android_tcpip_failed">Could not talk to the device over USB: %1$s</string>
    <string name="msg_android_tcpip_unreachable">The device did not answer ADB on %1$s:%2$d after the restart. Its address may have changed, or it refuses debugging over TCP.</string>
    <string name="msg_android_tcpip_success">ADB is listening on %1$s:%2$d and answered this app. Filled into the address fields; the USB device is no longer used.</string>

    <string name="error_android_adb_auth">The device refused the ADB authentication. Confirm the \"Allow USB debugging?\" prompt on it.</string>
    <string name="error_android_server_start">The helper could not be started on the device. Check that USB debugging is enabled.</string>
    <string name="error_android_socket_timeout">Timed out waiting for the helper\'s video socket. Unlock the device and make sure USB debugging is still authorised.</string>
    <string name="error_android_wire_silent">The device stopped answering on the ADB connection, so no channel could be opened. Reconnect the cable or the wireless debugging session.</string>
    <string name="error_android_wire_dropped">The device hung up on the ADB connection while the session was being set up. Wireless debugging serves one client at a time: quit adb or scrcpy on the PC, then check that wireless debugging is still on and that this app is still allowed to connect.</string>
    <string name="error_android_unsupported_opus">This build cannot decode Opus audio, so the device audio is forwarded as AAC instead.</string>

    <!-- Session toolbar shortcuts. Labels stay short for the narrow drawer. -->
    <string name="title_android_actions">Device actions</string>
    <string name="action_android_back">Back</string>
    <string name="action_android_home">Home</string>
    <string name="action_android_recents">Recents</string>
    <string name="action_android_rotate">Rotate</string>
    <string name="action_android_power">Power menu</string>

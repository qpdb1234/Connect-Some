<?xml version="1.0" encoding="utf-8"?><!--
  Background for the protocol badge on a server card. Deliberately quiet: the
  badge tells protocols apart, it should not compete with the server name.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <corners android:radius="4dp" />
    <stroke
        android:width="1dp"
        android:color="@color/colorBorder" />
</shape>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Background for the in-stream performance overlay (latency / FPS / drops).
  A semi-transparent rounded rectangle so the monospace stats stay readable
  regardless of the remote frame behind them.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#99000000" />
    <corners android:radius="6dp" />
</shape>

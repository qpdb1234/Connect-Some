<?xml version="1.0" encoding="utf-8"?><!--
  Background of the LocalSend floating ball: what the card folds into on the edge. It is a plain
  round disc, the same white as the mini card, so the ball reads as a detached window control
  rather than a strip. The ripple is masked to the circle so the touch highlight stays round.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#331A1A1A">
    <item android:id="@android:id/mask">
        <shape android:shape="oval">
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/colorMiniCard" />
            <stroke
                android:width="1dp"
                android:color="#221A1A1A" />
        </shape>
    </item>
</ripple>

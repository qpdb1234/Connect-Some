<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/padding_normal"
        tools:ignore="HardcodedText">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_round_rect"
            android:backgroundTint="@color/colorUrlBarBackground"
            android:minHeight="100dp">

            <EditText
                android:id="@+id/preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:autofillHints=""
                android:background="@android:color/transparent"
                android:hint="@string/hint_key_test"
                android:imeOptions="flagNoExtractUi|flagNoFullscreen"
                android:inputType="text" />

            <com.limelight.ui.prefs.KeyTestView
                android:id="@+id/input_area"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:focusable="true"
                android:focusableInTouchMode="true" />
        </FrameLayout>

        <ScrollView
            android:id="@+id/log_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2"
            android:layout_marginTop="@dimen/margin_small"
            android:focusable="false"
            android:background="@drawable/bg_round_rect"
            android:backgroundTint="@color/colorUrlBarBackground">

            <TextView
                android:id="@+id/event_log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:padding="@dimen/padding_small"
                android:textSize="11sp"
                tools:ignore="SmallSp" />
        </ScrollView>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="@dimen/action_btn_size">

            <CheckBox
                android:id="@+id/auto_copy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/msg_auto_copy_on_exit" />

            <Button
                android:id="@+id/reset_btn"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|bottom"
                android:text="@string/action_reset" />

            <Button
                android:id="@+id/copy_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|bottom"
                android:text="@android:string/copy" />

        </FrameLayout>
    </LinearLayout>
</layout>
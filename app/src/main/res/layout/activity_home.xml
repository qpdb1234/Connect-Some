<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/urlbar"
                style="@style/UrlBar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/urlbar_height"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:nextFocusLeft="@id/about_btn"
                android:nextFocusRight="@id/settings_btn"
                android:touchscreenBlocksFocus="false">

                <ImageButton
                    android:id="@+id/about_btn"
                    style="@style/ImageButton"
                    android:contentDescription="@string/title_about"
                    android:nextFocusRight="@id/urlbar"
                    android:src="@drawable/ic_info" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/desc_search_btn"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Caption" />

                <ImageButton
                    android:id="@+id/localsend_btn"
                    style="@style/ImageButton"
                    android:contentDescription="@string/desc_localsend_home"
                    android:nextFocusLeft="@id/urlbar"
                    android:nextFocusRight="@id/settings_btn"
                    android:src="@drawable/ic_localsend" />

                <ImageButton
                    android:id="@+id/settings_btn"
                    style="@style/ImageButton"
                    android:contentDescription="@string/desc_settings_btn"
                    android:nextFocusLeft="@id/urlbar"
                    android:src="@drawable/ic_settings" />

            </LinearLayout>

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tab_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:background="@android:color/transparent" />

        </com.google.android.material.appbar.AppBarLayout>

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/pager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>
</layout>